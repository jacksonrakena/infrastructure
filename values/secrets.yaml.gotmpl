{{- /*
  The only place secret values are read. Decrypts the environment's SOPS file
  and maps it onto Kubernetes Secrets. Apps reference these Secrets by name.
  (exec runs in this file's directory, hence the ../ path.)
*/ -}}
{{- $s := exec "sops" (list "decrypt" "--output-type" "json" (printf "../environments/%s/secrets.sops.yaml" .Environment.Name)) | fromJson -}}
secrets:
  {{- range $name, $cert := $s.tls }}
  tls-{{ $name }}:
    type: kubernetes.io/tls
    stringData:
      tls.crt: {{ $cert.crt | quote }}
      tls.key: {{ $cert.key | quote }}
  {{- end }}

  ghcr-pull:
    type: kubernetes.io/dockerconfigjson
    stringData:
      .dockerconfigjson: {{ $s.registry.ghcr | quote }}

  {{- range $role, $creds := $s.postgresRoles }}
  # Login for the Leode role "{{ $role }}". CloudNativePG reloads the role
  # password when this Secret changes (cnpg.io/reload).
  leode-role-{{ $role }}:
    type: kubernetes.io/basic-auth
    labels:
      cnpg.io/reload: "true"
    stringData:
      username: {{ $creds.username | quote }}
      password: {{ $creds.password | quote }}
  {{- end }}

  {{- range $app, $env := $s.env }}
  {{- if ne $app "authentik" }}
  {{ $app }}-env:
    stringData: {{ $env | toJson }}
  {{- end }}
  {{- end }}

  # Authentik reads its whole configuration from this Secret
  # (authentik.existingSecret), including the Leode credentials.
  authentik-env:
    stringData:
      {{- range $k, $v := $s.env.authentik }}
      {{ $k }}: {{ $v | quote }}
      {{- end }}
      AUTHENTIK_POSTGRESQL__USER: {{ $s.postgresRoles.authentik.username | quote }}
      AUTHENTIK_POSTGRESQL__PASSWORD: {{ $s.postgresRoles.authentik.password | quote }}

  # Tailscale operator OAuth client, mounted by the operator (oauthSecretVolume).
  operator-oauth:
    namespace: tailscale
    stringData:
      client_id: {{ $s.tailscaleOAuth.client_id | quote }}
      client_secret: {{ $s.tailscaleOAuth.client_secret | quote }}

configMaps:
  blank-targets:
    data:
      targets.kdl: {{ $s.blankTargets | quote }}
