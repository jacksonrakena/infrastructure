{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "declaration": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "./build",
    "rootDirs": ["./src", "./imports"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "imports/**/*.ts"],
  "exclude": ["node_modules", "dist", "build"]
}
